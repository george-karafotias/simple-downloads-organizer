<Window
    x:Class="SimpleDownloadsOrganizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Downloads Organizer">

    <Grid
        RequestedTheme="Dark"
        Background="#101318"
        Padding="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="5" Margin="0,0,0,24">
            <TextBlock
                Text="Downloads Organizer"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="#F1F4F9"/>

            <TextBlock
                Text="A cleaner Downloads folder, in one click."
                FontSize="14"
                Foreground="#9AA5B5"/>
        </StackPanel>

        <!-- Folder selection -->
        <Border
            Grid.Row="1"
            Background="#1B2029"
            BorderBrush="#303744"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">

            <StackPanel Spacing="14">

                <TextBlock
                    Text="SELECTED FOLDER"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#9AA5B5"/>

                <TextBlock
                    x:Name="FolderPathText"
                    Text="Choose a folder to get started"
                    FontSize="15"
                    Foreground="#F1F4F9"
                    TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="FileCountText"
                        Text="No folder selected"
                        Foreground="#9AA5B5"
                        VerticalAlignment="Center"/>

                    <Button
                        x:Name="ChooseFolderButton"
                        Grid.Column="1"
                        Content="Choose folder"
                        Padding="16,9"
                        Background="#29364A"
                        Foreground="#DCE8FF"
                        BorderThickness="0"
                        Click="ChooseFolderButton_Click"/>
                </Grid>

                <CheckBox
                    x:Name="AdvancedModeCheckBox"
                    Content="Advanced mode"
                    Foreground="#D3DAE5"
                    Checked="AdvancedModeCheckBox_Changed"
                    Unchecked="AdvancedModeCheckBox_Changed"/>

                <StackPanel
                    x:Name="AdvancedOptionsPanel"
                    Spacing="8"
                    Visibility="Collapsed">

                    <TextBlock
                        Text="Organization method"
                        Foreground="#D3DAE5"
                        FontWeight="SemiBold"/>

                    <ComboBox
                        x:Name="StrategyComboBox"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="StrategyComboBox_SelectionChanged">

                        <ComboBoxItem Content="Month and day"/>
                        <ComboBoxItem Content="File extension"/>
                        <ComboBoxItem Content="File category"/>

                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Primary actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button
                x:Name="OrganizeButton"
                Grid.Column="0"
                Content="Organize now"
                HorizontalAlignment="Stretch"
                Margin="0,0,6,0"
                Padding="12,13"
                Background="#3979DB"
                Foreground="White"
                BorderThickness="0"
                IsEnabled="False"
                Click="OrganizeButton_Click"/>

            <Button
                x:Name="PreviewChangesButton"
                Grid.Column="1"
                Content="Preview changes"
                HorizontalAlignment="Stretch"
                Margin="6,0,0,0"
                Padding="12,13"
                Background="#202630"
                Foreground="#DCE4F0"
                BorderBrush="#394352"
                BorderThickness="1"
                IsEnabled="False"
                Click="PreviewChangesButton_Click"/>

        </Grid>

        <!-- Preview -->
        <Border
            x:Name="PreviewPanel"
            Grid.Row="3"
            Margin="0,18,0,0"
            Padding="16"
            Background="#171B22"
            BorderBrush="#303744"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">

            <StackPanel Spacing="10">

                <TextBlock
                    Text="Preview changes"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#F1F4F9"/>

                <TextBlock
                    x:Name="PreviewDescriptionText"
                    Text="Review the proposed destinations."
                    Foreground="#9AA5B5"
                    TextWrapping="Wrap"/>

                <ListView
                    x:Name="PreviewList"
                    MaxHeight="320"
                    SelectionMode="None"
                    Background="Transparent">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Spacing="4"
                                Padding="6">

                                <TextBlock
                                    Text="{Binding FileName}"
                                    FontWeight="SemiBold"
                                    Foreground="#E8EDF5"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="{Binding ModifiedDate}"
                                    FontSize="12"
                                    Foreground="#9AA5B5"/>

                                <TextBlock
                                    Text="{Binding DestinationPath}"
                                    FontSize="12"
                                    Foreground="#8DB8FF"
                                    TextWrapping="Wrap"/>

                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackPanel>
        </Border>

        <!-- Status and undo -->
        <Border
            Grid.Row="4"
            Margin="0,18,0,0"
            Padding="12,10"
            Background="#1B2029"
            BorderBrush="#303744"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusText"
                    Text="Choose a folder to get started."
                    Foreground="#B5BFCE"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"/>

                <Button
                    x:Name="UndoButton"
                    Grid.Column="1"
                    Content="Undo"
                    Margin="12,0,0,0"
                    Padding="12,7"
                    Background="#29364A"
                    Foreground="#DCE8FF"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="UndoButton_Click"/>

            </Grid>
        </Border>

    </Grid>
</Window>
